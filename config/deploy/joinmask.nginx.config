# /etc/nginx/sites-available/joinmask.fetsh.me

server {
  listen 80;
  server_name joinmask.fetsh.me;

  root /var/www/joinmask/current/public;

  location / {
    try_files $uri @app;
  }

  location @app {
    proxy_pass http://unix:/var/www/joinmask/shared/tmp/sockets/puma.sock;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header Host $http_host;
    proxy_redirect off;
  }

  error_page 500 502 503 504 /500.html;
  client_max_body_size 4G;
}
